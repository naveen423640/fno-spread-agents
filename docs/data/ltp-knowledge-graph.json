  {
   "id": "rule:top-bottom-from-pairs",
   "type": "rule",
   "label": "The top and bottom come from the pressure of both sides",
   "source": "course",
   "status": "confirmed",
   "detail": "Detailed Chart of Accuracy 1.0, all 529 practice-tool cases verified (docs/ltp-coa-verification.md)."
  },
  {
   "id": "rule:wtt1-wtb1-substitution",
   "type": "rule",
   "label": "WTT-1 / WTB+1 replace the top / bottom only for a weak side with matching pressure",
   "source": "course",
   "status": "confirmed",
   "detail": "Resistance weak toward top now AND bullish gives WTT-1; support weak toward bottom now AND bearish gives WTB+1; a weak side with the other pressure keeps the plain level."
  },
  {
   "id": "rule:rare-do-not-trade",
   "type": "rule",
   "label": "Highly bearish against highly bullish: do not trade",
   "source": "course",
   "status": "confirmed",
   "detail": "The tool still names EOR+1 (WTT-1) as the risky top and EOS-1 (WTB+1) as the risky bottom."
  },
  {
   "id": "rule:first-hit-safe",
   "type": "rule",
   "label": "The first touch of a level is generally safe; risk rises with each further touch",
   "source": "course",
   "status": "confirmed",
   "detail": "From the chart of accuracy chapter."
  },
  {
   "id": "rule:weekly-range-bands",
   "type": "rule",
   "label": "Weekly range: risky, moderate and generally safe bands",
   "source": "course",
   "status": "confirmed",
   "detail": "L1 risky, L2 moderate, L3 generally safe (price plus or minus S, 2S, 3S)."
  },
  {
   "id": "rule:risky-high-pressure",
   "type": "rule",
   "label": "Tug of war: risky trades are allowed when both sides push one way, or one pushes highly and the other is stable",
   "source": "user",
   "status": "confirmed",
   "detail": "Bears winning gives a risky short, bulls winning a risky long, at the level the live tool shows as Risky. Sides pulling against each other are contested: no risky trade. A plain push against a stable side is only a mild lead: no risky trade. Do not skip on the first-level scenario: decide from the mind-map outcome."
  },
  {
   "id": "rule:one-diversion-stop",
   "type": "rule",
   "label": "Every trade risks one diversion: the stop is one strike step from the entry (NIFTY 50 points, BANKNIFTY and SENSEX 100)",
   "source": "user",
   "status": "confirmed",
   "detail": "Applies to every setup in v2.0 (reversal, 9:20, SOC, risky, very risky). Earlier versions keep the 9:20 style stop."
  },
  {
   "id": "rule:very-risky-eod",
   "type": "rule",
   "label": "Very high push allows very risky trades at the nearest end of diversion (EOD)",
   "source": "user",
   "status": "confirmed",
   "detail": "Very high = both sides push the same way and at least one pushes highly (highly with plain, or both highly). Bears winning: a very risky short at the nearest end of diversion above the price; bulls winning: a very risky long at the nearest end of diversion below it."
  },
  {
   "id": "rule:tool-lines-define-tiers",
   "type": "rule",
   "label": "The live tool shows the risky and moderate levels itself",
   "source": "user",
   "status": "confirmed",
   "detail": "Use the tool's displayed Risky and Moderate values, not our own formula (ours, EOR-1 / EOS+1, was a guess)."
  },
